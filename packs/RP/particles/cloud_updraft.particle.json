{
  "format_version": "1.10.0",
  "minecraft:particle_effect": {
    "description": {
      "identifier": "auralis:cloud_updraft",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/auralis_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 10
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.3, 2.2)"
      },
      "minecraft:particle_initial_speed": "math.random(1.2, 2.4)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.cos(v.particle_age * 4.5) * 0.65",
          2.4,
          "math.sin(v.particle_age * 4.5) * 0.65"
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.26 + 0.14 * (v.particle_age / v.particle_lifetime)",
          "0.26 + 0.14 * (v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            96,
            32
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00FFF4EC",
            "0.22": "#E0FFF0E4",
            "0.62": "#CCFFAEC6",
            "1.0": "#008AF4F2"
          }
        }
      },
      "minecraft:particle_initial_spin": {
        "initial_rotation": "math.random(0, 360)",
        "rotation_rate": 180
      },
      "minecraft:emitter_shape_disc": {
        "radius": 0.9,
        "plane_normal": "y",
        "surface_only": false,
        "direction": [
          0,
          1,
          0
        ]
      }
    }
  }
}