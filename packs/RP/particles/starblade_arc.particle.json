{
  "format_version": "1.10.0",
  "minecraft:particle_effect": {
    "description": {
      "identifier": "auralis:starblade_arc",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/auralis_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 10
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.65"
      },
      "minecraft:particle_initial_speed": "math.random(1.2, 2.4)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.1,
          0
        ],
        "linear_drag_coefficient": 1.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.55 * (1.0 - v.particle_age / v.particle_lifetime * 0.4)",
          "0.55 * (1.0 - v.particle_age / v.particle_lifetime * 0.4)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            64
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.3": "#FF7CF5F5",
            "0.7": "#CCFFD97A",
            "1.0": "#00D694FF"
          }
        }
      },
      "minecraft:particle_initial_spin": {
        "initial_rotation": "math.random(-25, 25)",
        "rotation_rate": 45
      }
    }
