{
  "format_version": "1.10.0",
  "minecraft:particle_effect": {
    "description": {
      "identifier": "auralis:wisp_notes",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/auralis_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 5
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.4, 2.2)"
      },
      "minecraft:particle_initial_speed": "math.random(0.4, 0.9)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(v.particle_age * 4) * 0.4",
          0.55,
          0
        ],
        "linear_drag_coefficient": 0.7
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          0.24,
          0.24
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            64,
            32
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFB4D4",
            "0.4": "#FFFFE29A",
            "0.8": "#CC86F5F2",
            "1.0": "#0086F5F2"
          }
        }
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.6,
        "surface_only": false,
        "direction": [
          0,
          1,
          0
        ]
      }
    }
  }
}