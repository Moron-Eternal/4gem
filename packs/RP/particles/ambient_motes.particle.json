{
  "format_version": "1.10.0",
  "minecraft:particle_effect": {
    "description": {
      "identifier": "auralis:ambient_motes",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/auralis_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 12
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(3.5, 6.0)"
      },
      "minecraft:particle_initial_speed": "math.random(0.15, 0.45)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(v.particle_age * 2) * 0.15",
          0.12,
          "math.cos(v.particle_age * 2) * 0.15"
        ],
        "linear_drag_coefficient": 0.6
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.10 + 0.08 * math.sin(v.particle_age * 3.14)",
          "0.10 + 0.08 * math.sin(v.particle_age * 3.14)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#007EF5EE",
            "0.25": "#E68AF5EE",
            "0.65": "#E6FFD4A6",
            "1.0": "#00FFA8C8"
          }
        }
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 14.0,
        "surface_only": false,
        "direction": [
          0,
          1,
          0
        ]
      }
    }
  }
}