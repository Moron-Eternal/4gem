{
  "format_version": "1.10.0",
  "minecraft:particle_effect": {
    "description": {
      "identifier": "auralis:veil_vortex",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/auralis_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 10
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.8, 2.8)"
      },
      "minecraft:particle_initial_speed": "math.random(0.8, 1.5)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.cos(v.particle_age * 5.0) * 1.4",
          1.2,
          "math.sin(v.particle_age * 5.0) * 1.4"
        ],
        "linear_drag_coefficient": 0.8
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.24 * (1.0 - v.particle_age / v.particle_lifetime * 0.5)",
          "0.24 * (1.0 - v.particle_age / v.particle_lifetime * 0.5)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            0,
            32
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#0094F8F4",
            "0.2": "#FF94F8F4",
            "0.6": "#FFFFD98A",
            "1.0": "#00F49EE0"
          }
        }
      },
      "minecraft:particle_initial_spin": {
        "initial_rotation": "math.random(0, 360)",
        "rotation_rate": 120
      },
      "minecraft:emitter_shape_disc": {
        "radius": 1.35,
        "plane_normal": "y",
        "surface_only": false,
        "direction": [
          0,
          1,
          0
        ]
      }
    }
  }
}