{
  "format_version": "1.10.0",
  "minecraft:particle_effect": {
    "description": {
      "identifier": "auralis:seraph_charge",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/auralis_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 14
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.85"
      },
      "minecraft:particle_initial_speed": "math.random(-2.4, -1.2)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.2,
          0
        ],
        "linear_drag_coefficient": 0.5
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.34 * (1.0 - v.particle_age / v.particle_lifetime * 0.5)",
          "0.34 * (1.0 - v.particle_age / v.particle_lifetime * 0.5)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            32,
            96
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#00FFE296",
            "0.25": "#FFFFE296",
            "0.70": "#E6E498FF",
            "1.0": "#0098F4F6"
          }
        }
      },
      "minecraft:particle_initial_spin": {
        "initial_rotation": "math.random(0, 360)",
