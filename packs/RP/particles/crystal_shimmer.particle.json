{
  "format_version": "1.10.0",
  "minecraft:particle_effect": {
    "description": {
      "identifier": "auralis:crystal_shimmer",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/auralis_particles"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 8
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.2
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.9, 1.5)"
      },
      "minecraft:particle_initial_speed": "math.random(0.3, 0.8)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0.45,
          0
        ],
        "linear_drag_coefficient": 1.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.18 * (1.0 - v.particle_age / v.particle_lifetime)",
          "0.18 * (1.0 - v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 128,
          "texture_height": 128,
          "uv": [
            32,
            32
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.0": "#FFFFFFFF",
            "0.4": "#FF7CF5F2",
            "0.8": "#BBD6A8FF",
            "1.0": "#00D6A8FF"
          }
        }
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.6,
        "surface_only": false,
        "direction": [
          0,
          1,
          0
        ]
      }
    }
  }
}